\Hypertarget{cmdproc_8c_af4b643cbe4d6c4473eec58b015044cdd}\index{cmdproc.c@{cmdproc.c}!checkSofEof@{checkSofEof}}
\index{checkSofEof@{checkSofEof}!cmdproc.c@{cmdproc.c}}
\doxysubsubsection{\texorpdfstring{checkSofEof()}{checkSofEof()}}
{\footnotesize\ttfamily \label{cmdproc_8c_af4b643cbe4d6c4473eec58b015044cdd} 
int check\+Sof\+Eof (\begin{DoxyParamCaption}\item[{int \texorpdfstring{$\ast$}{*}}]{sof\+Index}{, }\item[{int \texorpdfstring{$\ast$}{*}}]{eof\+Index}{}\end{DoxyParamCaption})}



Checks if data in the Rx buffer is valid by finding position index of SOF\+\_\+\+SYM and EOF\+\_\+\+SYM. 


\begin{DoxyParams}{Parameters}
{\em sof\+Index} & Position of start of frame symbol inside the UART Rx buffer. \\
\hline
{\em eof\+Index} & Position of end of frame symbol inside the UART Rx buffer.\\
\hline
\end{DoxyParams}
\begin{DoxyReturn}{Returns}
CMD\+\_\+\+EMPTY\+\_\+\+STRING (-\/1)\+: if the Rx buffer is empty ~\newline
 CMD\+\_\+\+MISSING\+\_\+\+SOF\+\_\+\+ERROR (-\/6)\+: SOF\+\_\+\+SYM not sent via Rx buffer ~\newline
 CMD\+\_\+\+MISSING\+\_\+\+EOF\+\_\+\+ERROR (-\/7)\+: EOF\+\_\+\+SYM not sent via Rx buffer ~\newline
 CMD\+\_\+\+OK (0)\+: frame contains both SOF\+\_\+\+SYM and EOF\+\_\+\+SYM and is not empty 
\end{DoxyReturn}
\Hypertarget{cmdproc_8c_afbdfe0465dfd34a5f244fe41fa27c12a}\index{cmdproc.c@{cmdproc.c}!cmdProcessor@{cmdProcessor}}
\index{cmdProcessor@{cmdProcessor}!cmdproc.c@{cmdproc.c}}
\doxysubsubsection{\texorpdfstring{cmdProcessor()}{cmdProcessor()}}
{\footnotesize\ttfamily \label{cmdproc_8c_afbdfe0465dfd34a5f244fe41fa27c12a} 
int cmd\+Processor (\begin{DoxyParamCaption}\item[{void}]{}{}\end{DoxyParamCaption})}



Processes the chars in the RX buffer looking for commands.\+abort. 

Supported commands\+: ~\newline
 A reads the real-\/time values of the variables provided by the sensor ~\newline
 P reads the real-\/time value of one of the sensors ~\newline
 L returns the last 20 samples of each variable ~\newline
 R resets the history

\begin{DoxyReturn}{Returns}
CMD\+\_\+\+OK (0)\+: if a valid command was found and executed ~\newline
 CMD\+\_\+\+EMPTY\+\_\+\+STRING (-\/1)\+: if empty string or incomplete command found ~\newline
 CMD\+\_\+\+INVALID (-\/2)\+: if an invalid command was found ~\newline
 CMD\+\_\+\+CS\+\_\+\+ERROR (-\/3)\+: if a CS error is detected (command not executed) ~\newline
 CMD\+\_\+\+BUFFER\+\_\+\+FULL (-\/4)\+: if the buffer is full CMD\+\_\+\+BUFFER\+\_\+\+EMPTY (-\/5)\+: if the buffer is empty CMD\+\_\+\+MISSING\+\_\+\+SOF\+\_\+\+ERROR (-\/6)\+: SOF\+\_\+\+SYM not sent via Rx buffer ~\newline
 CMD\+\_\+\+MISSING\+\_\+\+EOF\+\_\+\+ERROR (-\/7)\+: EOF\+\_\+\+SYM not sent via Rx buffer 
\end{DoxyReturn}
